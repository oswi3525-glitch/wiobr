# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Store SQLite data and uploaded files here. Relative paths use the project directory.
DATA_DIR=./data

# Browser/session security
SESSION_COOKIE=wiobr_session
SECURE_COOKIES=false
TRUST_PROXY_HOPS=0

# Leave empty when the frontend and API share the same origin.
CORS_ORIGIN=

# Search currently supports DuckDuckGo.
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Server log verbosity: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Optional Vite API origin override. Leave empty to use the current origin.
VITE_API_BASE_URL=

# Bootstrap-only credentials. Set temporarily when creating the first admin;
# do not reuse or commit real credentials here.
ADMIN_USERNAME=
ADMIN_PASSWORD=
